                        :show-select-all-button="true"
                        :is-all-selected="completedTasksList.length > 0 && completedTasksList.every(t => selectedTaskIds.includes(t.id))"
                        class="opacity-75"
                        @toggle-select-all="toggleSelectCompleted"
                        @toggle="toggleTask"
                        @select="toggleTaskSelection"
