<file path="resources/js/Pages/Dashboard.vue">
<script setup>
import { ref, computed, watch } from 'vue';
import AuthenticatedLayout from '@/Layouts/AuthenticatedLayout.vue';
import { Head, Link, router } from '@inertiajs/vue3';
import { Chart as ChartJS, ArcElement, Tooltip, Legend } from 'chart.js';
import { Doughnut } from 'vue-chartjs';
import draggable from 'vuedraggable';

ChartJS.register(ArcElement, Tooltip, Legend);

const props = defineProps({
    allTasks: { type: Array, default: () => [] },
    todayTasks: { type: Array, default: () => [] },
});

// タブ管理の状態
const activeTab = ref('all');

// 今日のタスク専用のドラッグ＆ドロップ用ローカル状態
const todayDragTasks = ref([...props.todayTasks]);

// 親（Props）から渡される今日のタスクデータが更新されたら同期させる
watch(() => props.todayTasks, (newTasks) => {
    todayDragTasks.value = [...newTasks];
}, { deep: true, immediate: true });

// 完了タスクを隠すフラグ
const hideCompleted = ref(false);
// 検索キーワード用
const searchQuery = ref('');
// ソート条件用
const sortBy = ref('due_date');

// 表示用のタスクを計算する（完了非表示 ＋ キーワード検索 ＋ 並び替え）
const filteredTasks = computed(() => {
    let tasks = [...props.allTasks];

    // 完了タスクを非表示にする
    if (hideCompleted.value) {
        tasks = tasks.filter(task => task.status !== 2);
    }

    // キーワードで絞り込む
    if (searchQuery.value) {
        const query = searchQuery.value.toLowerCase();
        tasks = tasks.filter(task => 
            task.title.toLowerCase().includes(query) || 
            (task.description && task.description.toLowerCase().includes(query)) ||
            (task.category && task.category.toLowerCase().includes(query))
        );
    }

    // 並び替え処理
    tasks.sort((a, b) => {
        if (sortBy.value === 'due_date') {
            return new Date(a.due_date || '9999-12-31') - new Date(b.due_date || '9999-12-31');
        } else if (sortBy.value === 'title') {
            return a.title.localeCompare(b.title);
        }
        return 0;
    });

    return tasks;
});

// 今日のタスク並び替え終了時の処理
const onEndToday = () => {
    router.patch(route('tasks.reorder'), {
        tasks: todayDragTasks.value.map((task, index) => ({ id: task.id, sort_order: index }))
    }, { preserveScroll: true });
};

// ==========================================
// 📊 【大幅改善】タブごとに目的が異なる統計ロジック
// ==========================================

// 1. 【マイタスク一覧（all）】用の「リスク・負荷」集計
const globalSummary = computed(() => {
    // 完了(status === 2) 以外の未完了タスクをベースにする
    const activeTasks = props.allTasks.filter(t => t.status !== 2);
    
    const uncompletedCount = activeTasks.length;
    
    // 期限切れタスクのカウント（未完了のみ）
    const expiredCount = activeTasks.filter(t => isExpired(t.due_date)).length;
    
    // 近日中のタスク（3日以内）
    const upcomingCount = upcomingTasks.value.length;

    // カテゴリ別の未完了タスク数を集計（グラフ用）
    const categoryMap = {};
    activeTasks.forEach(t => {
        const cat = t.category || '未分類';
        categoryMap[cat] = (categoryMap[cat] || 0) + 1;
    });

    return { uncompletedCount, expiredCount, upcomingCount, categoryMap };
});

// 2. 【今日のタスク（today）】用の「今日1日の消化率」集計
const todaySummary = computed(() => {
    const total = todayDragTasks.value.length;
    const completed = todayDragTasks.value.filter(t => t.status === 2).length;
    const remaining = total - completed;
    const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;
    
    return { total, completed, remaining, percentage };
});

// 3. 【動的グラフデータ】タブによってグラフの種類とデータを完全に分ける
const chartData = computed(() => {
    if (activeTab.value === 'today') {
        // 【今日のタスク】：単純な「完了」 vs 「残り」の消化円グラフ
        return {
            labels: ['完了', '残り'],
            datasets: [{
                data: [todaySummary.value.completed, todaySummary.value.remaining],
                backgroundColor: ['#10b981', '#f1f5f9'] // エメラルド（完了）と 薄グレー（残り）
            }]
        };
    } else {
        // 【マイタスク一覧】：未完了タスクの「カテゴリ別分布」グラフ（どこに負荷が偏っているか）
        const categories = Object.keys(globalSummary.value.categoryMap);
        const data = Object.values(globalSummary.value.categoryMap);
        
        // シックで統一感のあるニュアンスカラーパレット
        const colors = ['#6366f1', '#3b82f6', '#ec4899', '#f59e0b', '#10b981', '#64748b'];
        
        return {
            labels: categories.length > 0 ? categories : ['未完了タスクなし'],
            datasets: [{
                data: data.length > 0 ? data : [1],
                backgroundColor: data.length > 0 ? colors.slice(0, categories.length) : ['#e2e8f0']
            }]
        };
    }
});

// 近日中に期限が来るタスク（明日から3日後まで）
const upcomingTasks = computed(() => {
    const today = new Date();
    const threeDaysLater = new Date();
    threeDaysLater.setDate(today.getDate() + 3);

    return props.allTasks.filter(task => {
        if (!task.due_date || task.status === 2) return false;
        const dueDate = new Date(task.due_date);
        return dueDate > today && dueDate <= threeDaysLater;
    });
});

// 【改善】目に優しいニュアンスカラーに変更
const getStatusBadge = (status) => {
    const statuses = {
        0: { text: '⚪ 未着手', class: 'bg-slate-100/70 text-slate-600 border-slate-200' },
        1: { text: '⚡ 進行中', class: 'bg-indigo-50 text-indigo-600 border-indigo-150 font-medium' },
        2: { text: '✅ 完了', class: 'bg-emerald-50 text-emerald-600 border-emerald-150 font-medium' },
    };
    return statuses[status] || { text: '❓ 不明', class: 'bg-rose-50 text-rose-600 border-rose-200' };
};

// 【改善】通常時（非ホバー時）でも背景と完全に分離して見えるように、シャドウとボーダーを強化
const getCardClass = (task) => {
    if (isExpired(task.due_date) && task.status !== 2) {
        return 'border-l-2 border-l-rose-500 border-y-slate-200 border-r-slate-200 bg-white shadow-[0_2px_12px_rgba(15,23,42,0.06)]';
    }
    if (task.status === 2) {
        // 完了：終わったものなので、あえて影を消して背景に沈め、境界線だけで見せる
        return 'border-slate-200 bg-slate-50/60 opacity-60 shadow-none';
    }
    if (task.status === 1) {
        // 進行中：インディゴのラインに加え、常時しっかりとしたシャドウを付与して際立たせる
        return 'border-l-2 border-l-indigo-500 border-y-slate-200 border-r-slate-200 bg-white shadow-[0_4px_16px_rgba(99,102,241,0.08)]';
    }
    // 未着手（通常時）：不透明な境界線と、常時見える上品なミディアムシャドウ
    return 'border-slate-200 bg-white shadow-[0_4px_12px_rgba(15,23,42,0.06)] hover:border-slate-300 hover:shadow-[0_6px_20px_rgba(15,23,42,0.1)] transition-all duration-200';
};

const isToday = (dateString) => {
    const today = new Date().toISOString().split('T')[0];
    return dateString === today;
};

// 期限切れ判定関数
const isExpired = (dateString) => {
    if (!dateString) return false;
    const today = new Date().toISOString().split('T')[0];
    return dateString < today;
};

const updateStatus = (task) => {
    const nextStatus = (task.status + 1) % 3;
    router.patch(route('tasks.update', task.id), {
        status: nextStatus,
    });
};

const deleteTask = (taskId) => {
    if (confirm('本当にこのタスクを削除しますか？')) {
        router.delete(route('tasks.destroy', taskId));
    }
};

// 【改善】金・銀・銅を廃止し、グレースケールで美しく差別化
const getPriorityBadgeClass = (index) => {
    if (index === 0) {
        // 1番優先度が高いタスク：シックなチャコールで引き締める
        return 'bg-slate-800 text-white border-transparent font-semibold shadow-sm';
    }
    if (index === 1 || index === 2) {
        // 2, 3位：すっきりとしたダークグレー
        return 'bg-slate-100 text-slate-700 border-slate-200 font-medium';
    }
    // 4位以降：控えめな極薄グレー
    return 'bg-slate-50 text-slate-400 border-slate-100';
};
</script>

<template>
    <Head title="Dashboard" />

    <AuthenticatedLayout>
        <template #header>
            <div class="flex justify-between items-center">
                <h2 class="font-semibold text-lg text-slate-800 leading-tight">Dashboard</h2>
                <Link 
                    :href="route('tasks.create')" 
                    class="bg-slate-800 text-white px-4 py-2 rounded-md hover:bg-slate-700 transition text-sm font-medium"
                >
                    ＋ タスクを作成
                </Link>
            </div>
        </template>

        <div class="py-12 bg-slate-100/80 min-h-screen">
